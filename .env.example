# Opcional: copie para .env somente se precisar trocar alguma porta do host
DB_PORT=3307

# Porta para iniciar o servidor
# Opcional # Default 3333
API_PORT=

# URL de conecção com o banco de dados PostgreSQL
# Apenas para rodar fora do Docker. No Docker, o docker-compose.yml já define esta variável.
# exemplo: "postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public"
DATABASE_URL=

# Senha para validar o token
# pode ser gerado com o seguinte comando no terminal: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# Porta para iniciar o frontend
# Opcional # Default 5173
FRONTEND_PORT=
