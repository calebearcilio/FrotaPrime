# Copie para .env para configurar o ambiente local e o Docker Compose.
# Credenciais abaixo são apenas para desenvolvimento local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=frotaprime
POSTGRES_DB=frotaprime

# Opcional # Default 5432
DB_PORT=

# Porta para iniciar o servidor
# Opcional # Default 3000
API_PORT=

# Para executar a API fora do Docker, use localhost e ajuste usuário/senha/banco
# nesta URL se alterar os valores PostgreSQL acima.
DATABASE_URL="postgresql://postgres:frotaprime@localhost:5432/frotaprime?schema=public"

# Senha para validar o token
# pode ser gerado com o seguinte comando no terminal: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=local-development-secret-change-before-deploy

# Porta para iniciar o frontend
# Opcional # Default 5173
FRONTEND_PORT=
